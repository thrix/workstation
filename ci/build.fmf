provision:
  how: virtual

prepare:
  how: install
  package:
    - ansible-core
    - direnv
    - git-lfs
    - just
    - podman
    - xz

discover:
  how: shell
  tests:
    - name: container
      framework: shell
      test: |
        set -exuo pipefail

        direnv allow
        eval "$(direnv export bash)"

        # Install bluebuild
        bash <(curl -s https://raw.githubusercontent.com/blue-build/cli/main/install.sh)

        # The atmos rpm lives in Git LFS. Testing Farm copies a plain tree into
        # the guest with no .git, so "git lfs pull" has nothing to work with
        # and the 134 byte pointer stays on disk -- "just decrypt" then dies on
        # "xz -dk" with "File format not recognized". Clone the repo instead,
        # where git-lfs smudges the real content on checkout, and copy it over.
        if ! xz -t files/system/usr/share/rpms/*.encrypted.xz 2>/dev/null; then
          git clone --depth 1 https://github.com/thrix/workstation /tmp/lfs-src
          cp /tmp/lfs-src/files/system/usr/share/rpms/*.encrypted.xz \
            files/system/usr/share/rpms/
          rm -rf /tmp/lfs-src
        fi

        # Fail here rather than midway through decrypt if it is still a pointer
        xz -t files/system/usr/share/rpms/*.encrypted.xz

        # Login to container registry, decrypt secret data, build and push the new container image
        just login decrypt build push

execute:
  how: tmt
